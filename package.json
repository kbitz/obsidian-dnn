{
  "name": "daily-note-navigation",
  "version": "0.1.0",
  "private": true,
  "description": "Browse existing daily notes from the note header.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
