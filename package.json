    "install:local": "node scripts/install-local.mjs"
  },
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "^29.0.0",
    "moment": "2.30.1",
    "obsidian": "1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "5.0.1"
  }
